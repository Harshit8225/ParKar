# Copy to .env before running `docker compose up`.
# Only the variables docker-compose.yml reads belong here; the backend's own
# development settings live in backend/.env.

# ---- Required ----
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# Shared secret the entry/exit gate devices present as the X-Camera-Key header.
CAMERA_API_KEY=

# ---- Optional ----
HTTP_PORT=8080
MONGO_DB=smart_parking

# Origins allowed to call the API directly (the SPA is same-origin via Nginx).
CORS_ORIGINS=http://localhost:8080

# Vehicle recognition. Without a key, the gate endpoints only accept manual
# plate entry. The key stays on the backend and is never sent to the browser.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Payments. Without keys the gateway runs in mock mode, which the backend
# refuses to do when NODE_ENV=production.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

PLATFORM_COMMISSION_PERCENT=10
